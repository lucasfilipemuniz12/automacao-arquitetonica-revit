<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Vebram.Revit</AssemblyName>
    <Version>0.5.14</Version>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">D:\Autodesk\Revit2026\Revit 2026</RevitInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath><Private>false</Private><ExternallyResolved>true</ExternallyResolved></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="../../profiles/ARQ_Parametros_Compartilhados.txt" Link="profiles/ARQ_Parametros_Compartilhados.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckRevitReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll')" Text="Informe RevitInstallDir com a pasta do Revit 2026 instalado." />
  </Target>
</Project>






















